# Copy this file to .env.local and fill in real values.

# --- PostHog (analytics) ---
# Project API key from PostHog → Project Settings. Starts with "phc_".
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com if unset. Use https://us.i.posthog.com for US-hosted.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Supabase (waitlist storage) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service role key (NEVER expose to the client — server-only).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (confirmation email) ---
# API key from resend.com → API Keys. Starts with "re_".
# Sender (hello@auruby.io) must be a verified domain in Resend.
RESEND_API_KEY=

# --- Club signup notifications ---
# Where to send a notification email for each THE CLUB: Young Founders
# sign-up (parent's name, email, child's age, notes). Requires
# RESEND_API_KEY above. Leave unset to skip notification emails.
CLUB_SIGNUP_NOTIFY_EMAIL=

# --- Site ---
# Used in SEO/OG/canonical tags. Set to your production URL before deploy.
# Canonical production domain is https://auruby.io (code falls back to this if unset).
NEXT_PUBLIC_SITE_URL=https://auruby.io
